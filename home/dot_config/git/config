# Portable git settings for cli-workbench. Git reads ~/.config/git/config on its own, no include needed.
# Identity, proxy, internal-IP url rewrites and credential-helper paths stay in ~/.gitconfig (machine-specific).
[color]
	ui = true
[color "status"]
	changed = yellow
	untracked = red
	added = green
[http]
	postBuffer = 157286400
