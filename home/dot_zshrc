# cli-workbench zshrc: portable defaults. Everything optional is guarded, so a missing tool never breaks the shell.
# Per-machine settings (extra PATH entries, proxies, work tools) go in ~/.config/zsh/local.zsh, which is not tracked.

typeset -gU path                              # PATH without duplicate entries
_wb_zsh_dir=${XDG_CONFIG_HOME:-$HOME/.config}/zsh   # path.zsh and tmux-autostart.zsh are deployed here next to local.zsh

export LANG=${LANG:-en_US.UTF-8}
if (( $+commands[nvim] )); then export EDITOR=${EDITOR:-nvim}; else export EDITOR=${EDITOR:-vim}; fi

# PATH (static part lives in path.zsh)
source "$_wb_zsh_dir/path.zsh" || print -u2 "cli-workbench: FAILED to load $_wb_zsh_dir/path.zsh"

# History
HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS HIST_IGNORE_SPACE SHARE_HISTORY EXTENDED_HISTORY

# Options
setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP

# Completion (the dump file lives in the XDG cache dir, not in $HOME)
_wb_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $_wb_cache ]] || mkdir -p "$_wb_cache"
autoload -Uz compinit
# -i: silently skip insecure completion dirs instead of asking y/n (no terminal, CI).
# -C: reuse the dump without scanning fpath, which is fast but never sees completions installed later (brew install ...),
# so the dump is only reused while it is less than a day old; after that it is rebuilt once.
_wb_fresh=($_wb_cache/zcompdump(N.mh-24))
if (( $#_wb_fresh )); then compinit -i -C -d "$_wb_cache/zcompdump"; else compinit -i -d "$_wb_cache/zcompdump"; fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
unset _wb_cache _wb_fresh

# Key bindings: emacs style; Up/Down search history by the text already typed
if [[ -o zle ]]; then
  bindkey -e
  autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
  zle -N up-line-or-beginning-search
  zle -N down-line-or-beginning-search
  bindkey '^[[A' up-line-or-beginning-search
  bindkey '^[[B' down-line-or-beginning-search
fi

# Optional tools, used only when installed. starship cannot render under TERM=dumb or with TERM unset (test harnesses,
# some editor shells) and would print an error at every prompt there — the built-in prompt covers those cases too.
if (( $+commands[starship] )) && [[ -n $TERM && $TERM != dumb ]]; then eval "$(starship init zsh)"; else PROMPT='%F{green}%n%f@%m %F{blue}%~%f %# '; fi
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
if (( $+commands[fzf] )) && fzf --zsh >/dev/null 2>&1; then source <(fzf --zsh); fi   # fzf 0.48 or newer

if ls --color=auto / >/dev/null 2>&1; then alias ls='ls --color=auto'; else alias ls='ls -G'; fi   # GNU or BSD (macOS)
alias grep='grep --color=auto'
alias ll='ls -lah'
alias ..='cd ..'

# Not tracked: secrets and per-machine settings, sourced last
if [[ -r "$HOME/.config/zsh/secrets.zsh" ]]; then source "$HOME/.config/zsh/secrets.zsh"; fi
if [[ -r "$HOME/.config/zsh/local.zsh" ]]; then source "$HOME/.config/zsh/local.zsh"; fi

# Optional: syntax highlighting (zsh-syntax-highlighting). It must be sourced after everything that defines widgets, so it comes last.
# Install: brew install zsh-syntax-highlighting  (Debian/Ubuntu: apt install zsh-syntax-highlighting)
for _wb_hl in \
  /opt/homebrew/share/zsh-syntax-highlighting /usr/local/share/zsh-syntax-highlighting \
  /home/linuxbrew/.linuxbrew/share/zsh-syntax-highlighting /usr/share/zsh-syntax-highlighting \
  "$HOME/.zsh/zsh-syntax-highlighting" "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"; do
  if [[ -r $_wb_hl/zsh-syntax-highlighting.zsh ]]; then source "$_wb_hl/zsh-syntax-highlighting.zsh"; break; fi
done
unset _wb_hl

# Optional: a tmux session chooser in new terminal tabs. Off by default; turn it on in local.zsh with
#   export WB_TMUX_AUTOSTART=1
# For one shell that stays outside tmux:  TMUX_NO_AUTOSTART=1 zsh
if [[ -o interactive && -t 0 && -t 1 && -z $TMUX && -z ${TMUX_NO_AUTOSTART:-} && ${WB_TMUX_AUTOSTART:-0} == 1 ]]; then
  [[ -r ~/.config/zsh/tmux-autostart.zsh ]] && source ~/.config/zsh/tmux-autostart.zsh
fi
