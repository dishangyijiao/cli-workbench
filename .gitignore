local.zsh
secrets.zsh

# Environment files and key material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# NLPM score history (per-machine trend data)
.claude/nlpm-history.json

