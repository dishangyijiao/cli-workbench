#!/bin/sh
# Refuse pushes whose commit metadata (author, committer, message) would leak secrets or personal data — file scans
# never see metadata. Runs scripts/privacy-scan over every commit this push would add. Enable once per clone:
#   git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
rc=0
while read -r _ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                # a ref is being deleted: nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    set -- "$local_sha" --not --remotes                 # a new ref: everything not on a remote yet
  else
    set -- "$remote_sha..$local_sha"
  fi
  if ! "$root/scripts/privacy-scan" --commits "$@"; then
    echo "Push blocked by scripts/privacy-scan. Rewrite the commits above (git rebase), or add 'wb-scan: allow' to a deliberate exception." >&2
    rc=1
  fi
done
exit $rc
