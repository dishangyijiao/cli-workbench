#!/usr/bin/env bash
# link — plan or apply the symlinks declared in links.txt.
# Usage: link [component ...] [--apply] [--adopt]
#   (default)   print the plan only; nothing is changed
#   --apply     create links; existing files are moved to ~/.cli-workbench-backup/, never deleted
#   --adopt     also replace a real directory or a symlink that points elsewhere;
#               only for components named on the command line
set -eu
: "${HOME:?link: HOME is not set}"
. "$(dirname "$0")/lib.sh"

apply=0 adopt=0 want=""
for arg in "$@"; do
  case $arg in
    --apply) apply=1 ;;
    --adopt) adopt=1 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    -*) echo "link: unknown option: $arg" >&2; exit 2 ;;
    *) want="$want $arg" ;;
  esac
done
if [ "$adopt" = 1 ] && [ -z "$want" ]; then
  echo "link: --adopt needs explicit component names" >&2; exit 2
fi

wb_manifest_check || exit 2
known=$(wb_manifest | awk '{print $1}')
for w in $want; do
  printf '%s\n' "$known" | grep -qx "$w" || { echo "link: unknown component: $w" >&2; exit 2; }
done

selected() { [ -z "$want" ] && return 0; case " $want " in *" $1 "*) return 0 ;; esac; return 1; }

inventory() { # $1 source, $2 target
  local t
  t=$(wb_resolve "$2" 2>/dev/null) || { echo "       target is a dangling symlink -> $(readlink "$2")"; return 0; }
  if [ -d "$t" ] && [ -d "$1" ]; then
    echo "       differences (target vs repo):"
    diff -rq "$t" "$1" 2>&1 | head -40 | sed 's/^/         /' || true
  elif [ -f "$t" ] && [ -f "$1" ]; then
    diff -u "$t" "$1" 2>&1 | head -40 | sed 's/^/         /' || true
  else
    echo "       target and repo source differ in type"
  fi
}

backup_root=""
backup_and_move() { # $1 target
  local dest
  [ -n "$backup_root" ] || backup_root=$(wb_new_backup_root) || return 1
  dest=$backup_root$1
  mkdir -p "$(dirname "$dest")" || return 1
  printf "%s -> %s\n  undo: rm '%s' && mv '%s' '%s'\n" "$1" "$dest" "$1" "$dest" "$1" >> "$backup_root/RESTORE" || return 1
  mv "$1" "$dest" || return 1
  if { [ -e "$dest" ] || [ -L "$dest" ]; } && [ ! -e "$1" ] && [ ! -L "$1" ]; then return 0; fi
  echo "link: backup check failed for $1 (see $backup_root/RESTORE)" >&2
  return 1
}

make_link() { mkdir -p "$(dirname "$2")" && ln -s "$1" "$2"; }

rc=0
while read -r comp src tgt; do
  selected "$comp" || continue
  if [ ! -e "$src" ]; then echo "[FAIL] $comp: source missing: $src"; rc=1; continue; fi
  state=$(wb_state "$src" "$tgt")
  case $state in
    ok)
      echo "[ok]   $comp: $tgt" ;;
    missing)
      if [ "$apply" = 1 ]; then
        if make_link "$src" "$tgt"; then echo "[done] $comp: $tgt -> $src"
        else echo "[FAIL] $comp: cannot create $tgt"; rc=1; fi
      else echo "[plan] $comp: link $tgt -> $src"; fi ;;
    file)
      inventory "$src" "$tgt"
      if [ "$apply" = 1 ]; then
        if backup_and_move "$tgt" && make_link "$src" "$tgt"; then echo "[done] $comp: $tgt -> $src (backup: $backup_root)"
        else echo "[FAIL] $comp: backup or link failed; $tgt left as is or see RESTORE"; rc=1; fi
      else echo "[plan] $comp: back up $tgt, then link -> $src"; fi ;;
    dir|foreign-link|broken-link)
      inventory "$src" "$tgt"
      if [ "$adopt" = 1 ]; then
        if [ "$apply" = 1 ]; then
          if backup_and_move "$tgt" && make_link "$src" "$tgt"; then echo "[done] $comp: adopted $tgt -> $src (backup: $backup_root)"
          else echo "[FAIL] $comp: backup or link failed; see RESTORE"; rc=1; fi
        else echo "[plan] $comp: adopt: back up $state $tgt, then link -> $src"; fi
      else
        echo "[STOP] $comp: $tgt is a $state. Review the differences above, then: link $comp --apply --adopt"
        rc=1
      fi ;;
  esac
done < <(wb_manifest)

[ "$apply" = 1 ] || echo "(dry-run: nothing changed; add --apply to act)"
exit $rc
