#!/usr/bin/env bash
# zsh-snapshot — print the state an interactive LOGIN zsh reaches after loading a zshrc.
# Usage: zsh-snapshot <zshrc> [--ghostty] [--names FILE] [--pty]
#        zsh-snapshot <zshrc> --time [N]     median wall time (ms) of `zsh -l -i -c exit`
#        zsh-snapshot <zshrc> --zprof        zprof report for that zshrc
# Canonical start state: env -i with PATH=/usr/bin:/bin:/usr/sbin:/sbin, a login shell, and a private
# ZDOTDIR holding symlinks to the real ~/.zshenv and ~/.zprofile plus the given zshrc, so PATH is built
# by /etc/zprofile (path_helper) and ~/.zprofile exactly as in a real login shell. The caller's
# environment never leaks in. HOME is real (the zshrc depends on tools under it); GIT_CONFIG_GLOBAL and
# SSH_AUTH_SOCK are redirected/preset so `git config --global` and `ssh-agent` cannot touch real state.
# Existing ~/.zcompdump* regular files (not the *.lock directories compinit leaves behind) are copied into the ZDOTDIR so compinit is warm.
# --names FILE adds those names (one per line) to the `== resolution` section (used by zsh-compare
# so both sides resolve the union of names). stdin is not a tty except with --pty.
set -eu
rc=${1:?usage: zsh-snapshot <zshrc> [--ghostty] [--names FILE] [--pty] | --time [N] | --zprof}
shift
[ -f "$rc" ] || { echo "zsh-snapshot: no such file: $rc" >&2; exit 2; }
term_program="" names_file="" mode=probe n=10
while [ $# -gt 0 ]; do
  case $1 in
    --ghostty) term_program=ghostty ;;
    --names) names_file=${2:?--names needs a file}; shift ;;
    --pty) mode=pty ;;
    --zprof) mode=zprof ;;
    --time) mode=time
            case ${2:-} in ''|-*) ;; *) n=$2; shift ;; esac ;;
    *) echo "zsh-snapshot: unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

tmp=$(mktemp -d)
cleanup() { case $tmp in /tmp/*|/var/folders/*|/private/var/folders/*) rm -rf "$tmp" ;; esac; }
trap cleanup EXIT
rc_abs="$(cd "$(dirname "$rc")" && pwd -P)/$(basename "$rc")"

mkdir "$tmp/zd"
if [ "$mode" = zprof ]; then
  printf 'zmodload zsh/zprof\nsource "%s"\nzprof\n' "$rc_abs" > "$tmp/zd/.zshrc"
else
  ln -s "$rc_abs" "$tmp/zd/.zshrc"
fi
[ -e "$HOME/.zshenv" ]   && ln -s "$HOME/.zshenv"   "$tmp/zd/.zshenv"
[ -e "$HOME/.zprofile" ] && ln -s "$HOME/.zprofile" "$tmp/zd/.zprofile"
for f in "$HOME"/.zcompdump*; do [ -f "$f" ] && cp -p "$f" "$tmp/zd/"; done

cat > "$tmp/zsh-launch" <<EOF
#!/bin/sh
exec env -i HOME='$HOME' USER='${USER:-}' LOGNAME='${USER:-}' TERM=xterm-256color LANG=en_US.UTF-8 \\
  PATH=/usr/bin:/bin:/usr/sbin:/sbin ZDOTDIR='$tmp/zd' GIT_CONFIG_GLOBAL='$tmp/gitconfig' \\
  XDG_CACHE_HOME='$tmp/xdg-cache' XDG_STATE_HOME='$tmp/xdg-state' \\
  SSH_AUTH_SOCK='$tmp/agent.sock' WB_NAMES_FILE='$names_file' ${term_program:+TERM_PROGRAM=$term_program} \\
  zsh -l -i "\$@"
EOF
chmod +x "$tmp/zsh-launch"
run_zsh() { "$tmp/zsh-launch" "$@"; }

now_ms() { perl -MTime::HiRes=time -e 'printf "%.0f", time()*1000'; }

if [ "$mode" = time ]; then
  : > "$tmp/times"; i=0
  while [ "$i" -lt "$n" ]; do
    t0=$(now_ms); run_zsh -c exit </dev/null >/dev/null 2>&1 || true; t1=$(now_ms)
    echo $((t1 - t0)) >> "$tmp/times"; i=$((i + 1))
  done
  echo "times_ms $(tr '\n' ' ' < "$tmp/times")"
  sort -n "$tmp/times" | awk '{a[NR]=$1} END{print "median_ms " ((NR%2)?a[(NR+1)/2]:(a[NR/2]+a[NR/2+1])/2); print "samples " NR}'
  exit 0
fi
if [ "$mode" = zprof ]; then
  run_zsh -c exit </dev/null 2>&1 | head -40
  exit 0
fi

cat > "$tmp/probe.zsh" <<'EOF'
print -r -- "== path";        print -rl -- $path
print -r -- "== alias";       { alias -L; alias -Ls; } | sort
print -r -- "== functions";   for _wb_f in ${(ok)functions:#_wb_*}; do print -r -- "$_wb_f $(print -r -- "${functions[$_wb_f]}" | cksum)"; done
print -r -- "== fpath";       print -rl -- $fpath
print -r -- "== hooks";       for _wb_h in precmd preexec chpwd zshaddhistory zshexit periodic; do _wb_n=${_wb_h}_functions; print -r -- "$_wb_h: ${(P)_wb_n}"; done
print -r -- "== completions"; for _wb_k in ${(ok)_comps}; do print -r -- "$_wb_k ${_comps[$_wb_k]}"; done
print -r -- "== setopt";      setopt | sort
print -r -- "== bindkey";     bindkey | sort
print -r -- "== zstyle";      zstyle -L | sort
print -r -- "== hashdirs";    hash -d | sort
print -r -- "== params";      typeset -p | grep -Ev '(^| )(RANDOM|SECONDS|EPOCHSECONDS|EPOCHREALTIME|LINENO|COLUMNS|LINES|STARSHIP_[A-Z_]*|_wb_[a-z_]*|zsh_eval_context|funcstack|functrace|funcfiletrace|funcsourcetrace|_|OLDPWD|PWD|ZDOTDIR|GIT_CONFIG_GLOBAL|SSH_AUTH_SOCK|WB_NAMES_FILE|HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy)(=|$)' | sort
print -r -- "== env";         env | grep -Ev '^(_|SHLVL|PWD|OLDPWD|TMPDIR|ZDOTDIR|GIT_CONFIG_GLOBAL|SSH_AUTH_SOCK|WB_NAMES_FILE|STARSHIP_[A-Z_]*|HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy)=' | sort
print -r -- "== resolution"
_wb_names=()
for _wb_d in $path; do
  [[ -d $_wb_d ]] || continue
  for _wb_x in $_wb_d/*(N-*); do _wb_names+=(${_wb_x:t}); done
done
[[ -n $WB_NAMES_FILE && -r $WB_NAMES_FILE ]] && _wb_names+=(${(f)"$(<$WB_NAMES_FILE)"})
for _wb_n in ${(ou)_wb_names}; do print -r -- "$_wb_n	$(whence -p -- $_wb_n 2>/dev/null || print UNRESOLVED)"; done
EOF

if [ "$mode" = pty ]; then
  { echo 'print WB_BEGIN'; cat "$tmp/probe.zsh"; echo 'print WB_END'; } > "$tmp/probe-pty.zsh"
  printf 'source "%s"\nexit\n' "$tmp/probe-pty.zsh" | script -q /dev/null "$tmp/zsh-launch" > "$tmp/pty.out" 2>&1 || true
  if ! grep -q WB_BEGIN "$tmp/pty.out"; then echo PTY_UNAVAILABLE; exit 3; fi
  tr -d '\r' < "$tmp/pty.out" | awk '/^WB_BEGIN/{f=1;next} /^WB_END/{f=0} f' | sed "s#$tmp#TMP#g"
  exit 0
fi

set +e
run_zsh -c "$(cat "$tmp/probe.zsh")" </dev/null >"$tmp/stdout" 2>"$tmp/stderr"
status=$?
set -e
echo "== exit status"; echo "$status"
echo "== startup stderr"; sed "s#$tmp#TMP#g" "$tmp/stderr"
sed "s#$tmp#TMP#g" "$tmp/stdout"
exit "$status"
