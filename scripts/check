#!/usr/bin/env bash
# check — fast, read-only, side-effect-free verification of the workbench.
# Prints PASS/WARN/FAIL per item; exits 1 if any FAIL. Never starts an interactive shell,
# never runs tmux plugins, never writes to $HOME. Real startup tests live in `doctor --deep`.
set -u
. "$(dirname "$0")/lib.sh"

# Usage: check [component ...]   Limits the link checks (section 1) to those components; the syntax checks always run.
want="$*"
selected() { [ -z "$want" ] && return 0; case " $want " in *" $1 "*) return 0 ;; esac; return 1; }
known=$(wb_manifest | awk -F'\t' '{print $1}')
for w in $want; do
  printf '%s\n' "$known" | grep -qx "$w" || { echo "check: unknown component: $w" >&2; exit 2; }
done

# 1. every link resolves to the exact source declared in links.txt
while IFS=$'\t' read -r comp src tgt; do
  selected "$comp" || continue
  case $(wb_state "$src" "$tgt") in
    ok)      wb_pass "link $comp -> $src" ;;
    missing) wb_fail "link $comp: $tgt does not exist (run: scripts/link $comp --apply)" ;;
    *)       wb_fail "link $comp: $tgt does not resolve to $src" ;;
  esac
done < <(wb_manifest)

# 2. syntax only
syntax() { # label, command...
  local label=$1 out; shift
  if out=$("$@" 2>&1); then wb_pass "$label"; else wb_fail "$label: $out"; fi
}
if command -v zsh >/dev/null 2>&1; then
  for f in "$WB_ROOT/config/zsh/zshrc" "$WB_ROOT"/config/zsh/*.zsh; do
    [ -f "$f" ] && syntax "zsh -n config/zsh/$(basename "$f")" zsh -n "$f"
  done
else
  wb_warn "zsh not installed; zsh syntax checks skipped"
fi
for f in "$WB_ROOT"/scripts/*; do
  [ -f "$f" ] && syntax "bash -n scripts/$(basename "$f")" bash -n "$f"
done
syntax "sh -n config/tmux/scripts/branch.sh" sh -n "$WB_ROOT/config/tmux/scripts/branch.sh"
syntax "config/claude/statusline.test.sh" sh "$WB_ROOT/config/claude/statusline.test.sh"

# 3. nvim: parse every lua file with no plugins and no state (-u NONE -i NONE)
if [ ! -d "$WB_ROOT/config/nvim" ]; then
  :   # no nvim config in this repo; nothing to parse
elif command -v nvim >/dev/null 2>&1; then
  lua_cmd="lua for _, f in ipairs(vim.fn.globpath('$WB_ROOT/config/nvim', '**/*.lua', false, true)) do local ok, err = loadfile(f); if not ok then io.stderr:write(err .. '\\n'); vim.cmd('cquit 1') end end"
  # nvim creates $XDG_STATE_HOME/nvim/log even with -u NONE, so give it a throwaway state dir.
  nvim_tmp=$(mktemp -d)
  syntax "nvim lua files parse" env XDG_STATE_HOME="$nvim_tmp/state" XDG_CACHE_HOME="$nvim_tmp/cache" \
    XDG_DATA_HOME="$nvim_tmp/data" XDG_CONFIG_HOME="$nvim_tmp/config" \
    nvim --headless -u NONE -i NONE +"$lua_cmd" +qa
  case $nvim_tmp in /tmp/*|/var/folders/*|/private/var/folders/*) rm -rf "$nvim_tmp" ;; esac
else
  wb_warn "nvim not installed; lua parse check skipped"
fi

[ "$WB_FAILS" -eq 0 ]
