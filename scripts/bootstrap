#!/usr/bin/env bash
# bootstrap — phase 1 stub. Runs check, prints the link dry-run plan, installs nothing,
# never passes --apply. Homebrew / `brew bundle` / link --apply arrive with `install`.
set -u
here=$(dirname "$0")
echo "== check"
echo "(On a first run, FAIL lines about missing links only mean nothing is linked yet.)"
"$here/check" || echo "(check reported failures; expected until links are applied)"
echo
echo "== link plan (dry-run)"
"$here/link" || true
echo
echo "Review the plan above, then apply one component at a time:  scripts/link <component> --apply"
exit 0
