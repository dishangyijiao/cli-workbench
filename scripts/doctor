#!/usr/bin/env bash
# doctor — diagnose the workbench. Usage: doctor [--deep] [--skip-check]
#   (default)     check + tools + PATH + proxy + repo state
#   --deep        also start zsh, tmux and nvim for real, isolated from live state
#   --skip-check  do not run scripts/check first (used by tests)
# Prints PASS/WARN/FAIL; exits 1 if any FAIL.
set -u
. "$(dirname "$0")/lib.sh"

deep=0 skipcheck=0
for arg in "$@"; do
  case $arg in
    --deep) deep=1 ;;
    --skip-check) skipcheck=1 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) echo "doctor: unknown option: $arg" >&2; exit 2 ;;
  esac
done

# 1. check
if [ "$skipcheck" = 0 ]; then
  "$WB_ROOT/scripts/check" || WB_FAILS=$((WB_FAILS+1))
fi

# 2. tools
for t in tmux zsh git; do
  if command -v "$t" >/dev/null 2>&1; then wb_pass "$t found: $(command -v "$t")"; else wb_fail "$t not found"; fi
done
for t in fzf zoxide nvim brew; do
  if command -v "$t" >/dev/null 2>&1; then wb_pass "$t found"; else wb_warn "$t not found"; fi
done
if command -v ghostty >/dev/null 2>&1 || [ -d /Applications/Ghostty.app ]; then wb_pass "ghostty found"; else wb_warn "ghostty not found"; fi

# 3. PATH
seen=":"; oldifs=$IFS; IFS=:; path_ok=1
for d in $PATH; do
  [ -n "$d" ] || continue
  case $seen in *":$d:"*) wb_warn "PATH duplicate: $d"; path_ok=0 ;; esac
  seen="$seen$d:"
  [ -d "$d" ] || { wb_warn "PATH entry does not exist: $d"; path_ok=0; }
done
IFS=$oldifs
[ "$path_ok" = 1 ] && wb_pass "PATH has no duplicates or missing dirs"

# 4. proxy: a listening port is only weak evidence of a proxy, so it is never PASS
proxy=${HTTP_PROXY:-${http_proxy:-}}
if [ -z "$proxy" ]; then
  wb_pass "no proxy configured"
else
  hostport=${proxy#*://}; hostport=${hostport%%/*}
  hostport=${hostport##*@}   # drop user:password@ so credentials never reach the output
  port=${hostport##*:}
  if nc -z -G 1 127.0.0.1 "$port" >/dev/null 2>&1; then
    wb_warn "HTTP_PROXY points at $hostport and the port is listening (not verified to be a proxy)"
  else
    wb_warn "HTTP_PROXY points at $hostport but nothing is listening (stale proxy variables)"
  fi
fi

# 5. repo state
if ! git -C "$WB_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  wb_warn "not a git repository (installed from an archive, or git is missing); cannot tell whether files were edited"
elif ! git_status=$(git -C "$WB_ROOT" status --porcelain 2>&1); then
  wb_warn "git status failed ($(printf '%s' "$git_status" | head -1)); cannot tell whether files were edited"
elif [ -n "$git_status" ]; then
  wb_warn "repo has uncommitted changes (local edits not yet synced to Git)"
else
  wb_pass "repo has no uncommitted changes"
fi

# 6. deep: real startups. zsh and tmux are isolated (throwaway cache dirs / private socket); nvim uses your real
#    config and data on purpose, so its caches and state go to a throwaway dir but a plugin manager may still update.
if [ "$deep" = 1 ]; then
  if command -v zsh >/dev/null 2>&1; then
    snap=$("$WB_ROOT/scripts/zsh-snapshot" "$WB_ROOT/config/zsh/zshrc" 2>&1); zrc=$?
    if [ "$zrc" -ne 0 ]; then wb_fail "zsh startup exited $zrc"
    else
      errs=$(printf '%s\n' "$snap" | awk '/^== startup stderr/{f=1;next} /^== path/{f=0} f')
      if [ -n "$errs" ]; then wb_warn "zsh startup printed to stderr (see: scripts/zsh-snapshot config/zsh/zshrc)"
      else wb_pass "zsh interactive startup is clean"; fi
    fi
  fi

  if command -v tmux >/dev/null 2>&1; then
    # Private server only (-L always given). No kill-server: killing the one session on the private
    # socket ends that server, and can never reach the user's live tmux.
    sock=wb-doctor-$$
    trap 'tmux -L "$sock" kill-session -t wbdoctor >/dev/null 2>&1' EXIT
    tdir=$(mktemp -d)
    grep -Ev "@plugin|@continuum|@resurrect|@fzf-url|tpm/tpm" "$WB_ROOT/config/tmux/tmux.conf" > "$tdir/tmux.conf"
    tmux -L "$sock" -f /dev/null new-session -d -s wbdoctor 2>/dev/null
    if err=$(tmux -L "$sock" source-file "$tdir/tmux.conf" 2>&1); then
      wb_pass "tmux config loads (private socket, plugins stripped)"
    else
      wb_fail "tmux config: $err"
    fi
    tmux -L "$sock" kill-session -t wbdoctor >/dev/null 2>&1
    case $tdir in /tmp/*|/var/folders/*|/private/var/folders/*) rm -rf "$tdir" ;; esac
  fi

  if command -v nvim >/dev/null 2>&1; then
    nvtmp=$(mktemp -d)
    if err=$(XDG_STATE_HOME="$nvtmp/state" XDG_CACHE_HOME="$nvtmp/cache" nvim --headless -i NONE +qa 2>&1); then
      [ -z "$err" ] && wb_pass "nvim starts cleanly" || wb_warn "nvim startup printed: $(printf '%s' "$err" | head -1)"
    else
      wb_fail "nvim startup failed: $(printf '%s' "$err" | head -1)"
    fi
    case $nvtmp in /tmp/*|/var/folders/*|/private/var/folders/*) rm -rf "$nvtmp" ;; esac
  fi
fi

[ "$WB_FAILS" -eq 0 ]
