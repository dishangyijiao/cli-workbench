#!/usr/bin/env bash
# Read-only workstation diagnostics. Never installs packages or modifies settings.
set -u
missing=0
check() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'OK      %-18s %s\n' "$1" "$(command -v "$1")"
  else
    printf 'MISSING %s\n' "$1"
    missing=$((missing + 1))
  fi
}
printf 'System: %s\n' "$(uname -s)"
for tool in git chezmoi zsh tmux ghostty fzf rg jq nvim zoxide starship xdg-open; do
  check "$tool"
done
if [ "$(uname -s)" = Linux ]; then
  printf 'XDG_SESSION_TYPE=%s\n' "${XDG_SESSION_TYPE:-unset}"
  printf 'XDG_CURRENT_DESKTOP=%s\n' "${XDG_CURRENT_DESKTOP:-unset}"
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    printf 'Wayland socket: %s\n' "$WAYLAND_DISPLAY"
  else
    printf 'Wayland socket: unavailable (expected over SSH/headless)\n'
  fi
fi
if [ -n "${TMUX:-}" ]; then printf 'tmux: attached\n'; else printf 'tmux: not attached\n'; fi
printf 'Missing command count: %s\n' "$missing"
[ "$missing" -eq 0 ]
