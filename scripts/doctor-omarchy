#!/usr/bin/env bash
# Read-only diagnostics for CLI Workbench on Arch/Omarchy.
set -u
mode=auto
case ${1:-} in
  '') ;;
  --headless) mode=headless ;;
  --desktop) mode=desktop ;;
  *) echo 'usage: bash scripts/doctor-omarchy [--headless|--desktop]' >&2; exit 2 ;;
esac
if [ "$mode" = auto ]; then
  if [ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ] || [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then mode=headless
  else mode=desktop
  fi
fi
missing=0
check() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'OK       %-18s %s\n' "$1" "$(command -v "$1")"
  else
    printf 'MISSING  %s\n' "$1"
    missing=$((missing + 1))
  fi
}
optional() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'OPTIONAL %-18s installed\n' "$1"
  else
    printf 'OPTIONAL %-18s not installed\n' "$1"
  fi
}
printf 'System: %s\nMode: %s\n' "$(uname -s)" "$mode"
for tool in git chezmoi zsh tmux fzf rg jq nvim; do check "$tool"; done
for tool in zoxide starship; do optional "$tool"; done
if [ "$mode" = desktop ]; then
  for tool in ghostty xdg-open wl-copy wl-paste; do check "$tool"; done
  printf 'XDG_SESSION_TYPE=%s\nXDG_CURRENT_DESKTOP=%s\n' "${XDG_SESSION_TYPE:-unset}" "${XDG_CURRENT_DESKTOP:-unset}"
  if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    echo 'WARNING: no graphical display detected; use --headless over SSH'
    missing=$((missing + 1))
  fi
fi
printf 'tmux: %s\n' "$([ -n "${TMUX:-}" ] && echo attached || echo not-attached)"
printf 'Missing required commands: %s\n' "$missing"
[ "$missing" -eq 0 ]
