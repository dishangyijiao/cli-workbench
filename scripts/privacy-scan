#!/usr/bin/env bash
# privacy-scan [--staged | --all | --commits <rev>...]
# Refuses to let secrets or personal data reach a public repo. Used by the pre-commit hook (--staged: only the lines
# about to be committed), by the pre-push hook (--commits: the metadata of the commits a push would add), by CI and by
# hand (--all: every tracked file). It prints WHERE a finding is, never the value.
#
# Rules: private keys, well-known token formats, secret-looking assignments, /Users/<name> and /home/<name> paths,
# e-mail addresses, sensitive file names (.env, *.pem, *.key, id_rsa ...), and your own deny list.
# --commits scans the author, the committer and the message of the named commits instead of files. The e-mail rule does
# not run there — a commit's own address is the author's choice; a private address belongs in the deny list.
# Deny list: one word per line in ~/.config/cli-workbench/deny.txt (or $WB_DENY_FILE). Keep it OUT of the repo.
# A deliberate exception: put "wb-scan: allow" on that line.
set -u
mode=${1:---all}
if [ "$mode" = --commits ]; then shift; [ $# -ge 1 ] || mode=usage; fi
case $mode in --staged | --all | --commits) ;; *) echo "usage: privacy-scan [--staged | --all | --commits <rev>...]" >&2; exit 2 ;; esac
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "privacy-scan: not a git repository" >&2; exit 2; }
cd "$root" || exit 2
deny=${WB_DENY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/cli-workbench/deny.txt}
if [ "$mode" = --commits ] && ! git rev-list "$@" >/dev/null 2>&1; then
  echo "privacy-scan: --commits: not a valid revision: $*" >&2
  exit 2
fi
work=$(mktemp -d) || exit 2
trap 'rm -rf "$work"' EXIT

# 1. Lines to scan, as location:text.
if [ "$mode" = --staged ]; then
  git diff --cached -U0 --no-color --diff-filter=ACMR | awk '
    /^\+\+\+ /   { f = ($0 ~ /^\+\+\+ \/dev\/null/) ? "" : substr($0, 7); next }
    /^@@/        { if (match($0, /\+[0-9]+/)) ln = substr($0, RSTART + 1, RLENGTH - 1) + 0; next }
    /^\+/        { if (f != "") { print f ":" ln ":" substr($0, 2); ln++ } }'
elif [ "$mode" = --commits ]; then
  git log --format='%x01%h%n%an <%ae>%n%cn <%ce>%n%B' "$@" | awk -v RS='\001' '
    NR > 1 { n = split($0, L, "\n"); sha = L[1]; ln = 0
             for (i = 2; i <= n; i++) if (L[i] != "") { ln++; print sha ":" ln ":" L[i] } }'
else
  git grep -I -n -e '' 2>/dev/null
fi | grep -v 'wb-scan: allow' > "$work/lines_all"
# The scanner and its own tests contain the patterns on purpose, so the pattern rules (assignments, paths, e-mail, deny list)
# skip them. Private keys and token formats are checked in every file: those fixtures are assembled from parts and never hold
# a real-looking value, so a real secret pasted into one of these files is still caught.
grep -v -E '^(scripts/privacy-scan|tests/privacy-scan\.test\.sh|tests/defaults\.test\.sh):' "$work/lines_all" > "$work/lines"

if [ "$mode" = --staged ]; then git diff --cached --name-only --diff-filter=ACMR > "$work/names"
elif [ "$mode" = --commits ]; then : > "$work/names"   # commit metadata only; the sensitive-file rule finds nothing there
else git ls-files > "$work/names"; fi

found=0
rule() { # name, extended regex, [grep flags]
  local m; m=$(grep -E ${3:-} -e "$2" "$work/${4:-lines}") || return 0
  printf '%s\n' "$m" | cut -d: -f1,2 | sort -u | sed "s/^/FAIL  $1  /"
  found=1
}

rule private-key  '-----BEGIN [A-Z ]*PRIVATE KEY-----' '' lines_all
rule secret-token '(sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|xai-[A-Za-z0-9_-]{20,})' '' lines_all

# Secret-looking assignment with a literal value. A value that starts with $ (a variable or $(command)), < (a <placeholder>),
# ( { [ or * (a masked value) is not literal; any other run of 12+ characters without spaces or quotes is, so symbols in a
# password cannot hide it. Placeholder words are judged on the assignment itself, not on the rest of the line, so a trailing
# comment such as "# copied from the example" cannot hide a real value.
assign_re='(API_?KEY|SECRET|TOKEN|PASSWORD|PASSWD|PRIVATE_?KEY)[A-Za-z_]*[[:space:]]*[=:][[:space:]]*['"'"'"]?[^[:space:]'"'"'"$<({[*][^[:space:]'"'"'"]{11,}'
grep -i -E -o -n -e "$assign_re" "$work/lines" | while IFS=: read -r n match; do
  printf '%s\n' "$match" | grep -q -i -E -e 'example|changeme|your[-_]|xxxx|dummy|placeholder|<[^>]*>' && continue
  sed -n "${n}p" "$work/lines" | cut -d: -f1,2
done > "$work/assign"
rule secret-assign '.' '' assign

grep -E -e '/Users/[A-Za-z]|/home/[a-z]' "$work/lines" | grep -v -e 'linuxbrew' -e '/home/dot_' > "$work/home"   # home/dot_* is the chezmoi source tree, not a personal path || true
rule home-path '.' '' home

# E-mail addresses, except git@host (ssh remotes), *@noreply and *@example.*. Not in --commits mode: a commit's own
# address is the author's choice; a private address is caught there through the deny list instead.
if [ "$mode" != --commits ]; then
  sed -E 's/git@[A-Za-z0-9.-]+//g; s/[A-Za-z0-9._%+-]+@(users\.)?noreply[A-Za-z0-9.-]*//g; s/[A-Za-z0-9._%+-]+@example\.[a-z]+//g' "$work/lines" > "$work/mail_in"
  grep -E -e '[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}' "$work/mail_in" > "$work/mail" || true
  rule email '.' '' mail
fi

# Sensitive file names, even when empty. .env.example is the documented exception.
grep -E '(^|/)\.env(\.[^/]*)?$|\.(pem|key|p12|pfx)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$' "$work/names" | grep -v -E '\.env\.example$' | sed 's/^/FAIL  sensitive-file  /' > "$work/files" || true
if [ -s "$work/files" ]; then cat "$work/files"; found=1; fi

# Your own words (names, private project names, your e-mail address), kept outside the repo. Matched case-insensitively.
if [ "$mode" = --commits ] && [ ! -r "$deny" ]; then
  echo "privacy-scan: no deny list at $deny (commit metadata is not checked against your private words)" >&2
fi
if [ -r "$deny" ]; then
  grep -v -E '^[[:space:]]*(#|$)' "$deny" | tr -d '\r' > "$work/deny"
  if [ -s "$work/deny" ]; then
    grep -i -F -f "$work/deny" "$work/lines" | cut -d: -f1,2 | sort -u | sed 's/^/FAIL  deny-list  /' > "$work/denyhits" || true
    if [ -s "$work/denyhits" ]; then cat "$work/denyhits"; found=1; fi
  fi
fi

if [ "$found" = 1 ]; then
  echo "privacy-scan: findings above (values are not printed; open the file or commit at that location)." >&2
  echo "A deliberate exception: add 'wb-scan: allow' on that line." >&2
  exit 1
fi
exit 0
